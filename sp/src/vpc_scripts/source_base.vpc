//-----------------------------------------------------------------------------
//	source_base.VPC
//
//  This is the base VPC file that is included by all others, on all platforms.
//
//	Project Script
//-----------------------------------------------------------------------------

// Set which branch we are building out of.
// This is one file we expect to be different between branches and so it must be merged carefully

// Staging branch:
//$Conditional STAGING_ONLY	"1"

// rel/tf_beta branch:
//$Conditional TF_BETA	"1"

//-----------------------------------------------------------------------------

// Mapbase functionality conditionals
$Conditional MAPBASE	"1" // Equivalent to (and required for) our MAPBASE preprocessor defined below
$Conditional MAPBASE_RPC	"1" // Toggles Mapbase's Rich Presence Client implementations (requires discord-rpc.dll in game bin)
$Conditional MAPBASE_VSCRIPT	"1" // Toggles VScript implementation (note: interfaces still exist, just the provided implementation is not present)
$Conditional NEW_RESPONSE_SYSTEM	"1" // Toggles the new Response System library based on the Alien Swarm SDK

//-----------------------------------------------------------------------------

// VKZ snippets conditionals

// Development
$Conditional VKZ_DEV "1" // Additional debugging codes
$conditional VKZ_NEVER_DEFINE "0" // Deprecated snippets or snippets only used for explanation

// Functionalities
$Conditional VKZ_ADVANCED_SPRINT "1" // Advanced Sprint
$Conditional VKZ_ADVANCED_BREATHER "1" // Advanced Breather
$Conditional VKZ_ALWAYS_RUN "1" // Always Run
$Conditional VKZ_FIX_QUANTUM_CROUCH "1" // Fix Quantum Crouch

// Suit Power Device snippets
$Conditional VKZ_INVALID_SUIT_POWER_DEVICE "1" // Invalid Suit Power Device
$Conditional VKZ_RESTORABLE_SUIT_POWER_DEVICE "1" // Restorable Suit Power Device
$Conditional VKZ_DATADESC_SUIT_POWER_DEVICE "1" // DATADESC Suit Power Device
$Conditional VKZ_NETWORKABLE_SUIT_POWER_DEVICE "1" // Networkable Suit Power Device

// Modifiers
$Conditional VKZ_EMBEDDED_SPRINT_DEVICE_FIELD "0" // Advanced Sprint: Prefer to use `DEFINE_EMBEDDED` for `m_SprintDevice`
$Conditional VKZ_EMBEDDED_BREATHER_DEVICE_FIELD "1" // Advanced Breather: Prefer to use `DEFINE_EMBEDDED` for `m_BreatherDevice`

//-----------------------------------------------------------------------------

$Configuration "Debug"
{
	$Compiler
	{
		// Pass on appropriate branch define to preprocessor
		$PreprocessorDefinitions		"VPC"
		$PreprocessorDefinitions		"$BASE;STAGING_ONLY" [$STAGING_ONLY]
		$PreprocessorDefinitions		"$BASE;TF_BETA" [$TF_BETA]
		$PreprocessorDefinitions		"$BASE;RAD_TELEMETRY_DISABLED" [$SOURCESDK]
// Need to revisit the code to make things run with the _RETAIL preprocessor definition
// This line was added in the previous check-in, but had previously not been defined in this branch
//		$PreprocessorDefinitions		"$BASE;_RETAIL"		[$RETAIL]

		// Mapbase base definitions
		$PreprocessorDefinitions		"$BASE;MAPBASE"		[$MAPBASE]

    // VKZ
		$PreprocessorDefinitions		"$BASE;VKZ_DEV" [$VKZ_DEV]
	    	$PreprocessorDefinitions    		"$BASE;VKZ_NEVER_DEFINE" [$VKZ_NEVER_DEFINE]
		$PreprocessorDefinitions		"$BASE;VKZ_ADVANCED_SPRINT" [$VKZ_ADVANCED_SPRINT]
		$PreprocessorDefinitions		"$BASE;VKZ_ADVANCED_BREATHER" [$VKZ_ADVANCED_BREATHER]
		$PreprocessorDefinitions		"$BASE;VKZ_ALWAYS_RUN" [$VKZ_ALWAYS_RUN]
		$PreprocessorDefinitions		"$BASE;VKZ_FIX_QUANTUM_CROUCH" [$VKZ_FIX_QUANTUM_CROUCH]
    		$PreprocessorDefinitions    		"$BASE;VKZ_INVALID_SUIT_POWER_DEVICE" [$VKZ_INVALID_SUIT_POWER_DEVICE]
    		$PreprocessorDefinitions    		"$BASE;VKZ_RESTORABLE_SUIT_POWER_DEVICE" [$VKZ_RESTORABLE_SUIT_POWER_DEVICE]
    		$PreprocessorDefinitions    		"$BASE;VKZ_DATADESC_SUIT_POWER_DEVICE" [$VKZ_DATADESC_SUIT_POWER_DEVICE]
    		$PreprocessorDefinitions    		"$BASE;VKZ_NETWORKABLE_SUIT_POWER_DEVICE" [$VKZ_NETWORKABLE_SUIT_POWER_DEVICE]
    		$PreprocessorDefinitions    		"$BASE;VKZ_EMBEDDED_SPRINT_DEVICE_FIELD" [$VKZ_EMBEDDED_SPRINT_DEVICE_FIELD]
        $PreprocessorDefinitions        "$BASE;VKZ_EMBEDDED_BREATHER_DEVICE_FIELD" [$VKZ_EMBEDDED_BREATHER_DEVICE_FIELD]
	}
}

$Configuration "Release"
{
	$Compiler
	{
		// Pass on appropriate branch define to preprocessor
		$PreprocessorDefinitions		"VPC"
		$PreprocessorDefinitions		"$BASE;STAGING_ONLY" [$STAGING_ONLY]
		$PreprocessorDefinitions		"$BASE;TF_BETA" [$TF_BETA]
		$PreprocessorDefinitions		"$BASE;RAD_TELEMETRY_DISABLED" [$SOURCESDK]
// Need to revisit the code to make things run with the _RETAIL preprocessor definition
// This line was added in the previous check-in, but had previously not been defined in this branch
//		$PreprocessorDefinitions		"$BASE;_RETAIL"		[$RETAIL]

		// Mapbase base definitions
		$PreprocessorDefinitions		"$BASE;MAPBASE"		[$MAPBASE]

		// VKZ
		$PreprocessorDefinitions		"$BASE;VKZ_ADVANCED_SPRINT" [$VKZ_ADVANCED_SPRINT]
		$PreprocessorDefinitions		"$BASE;VKZ_ADVANCED_BREATHER" [$VKZ_ADVANCED_BREATHER]
		$PreprocessorDefinitions		"$BASE;VKZ_ALWAYS_RUN" [$VKZ_ALWAYS_RUN]
		$PreprocessorDefinitions		"$BASE;VKZ_FIX_QUANTUM_CROUCH" [$VKZ_FIX_QUANTUM_CROUCH]
    		$PreprocessorDefinitions    		"$BASE;VKZ_INVALID_SUIT_POWER_DEVICE" [$VKZ_INVALID_SUIT_POWER_DEVICE]
    		$PreprocessorDefinitions    		"$BASE;VKZ_RESTORABLE_SUIT_POWER_DEVICE" [$VKZ_RESTORABLE_SUIT_POWER_DEVICE]
    		$PreprocessorDefinitions    		"$BASE;VKZ_DATADESC_SUIT_POWER_DEVICE" [$VKZ_DATADESC_SUIT_POWER_DEVICE]
    		$PreprocessorDefinitions    		"$BASE;VKZ_NETWORKABLE_SUIT_POWER_DEVICE" [$VKZ_NETWORKABLE_SUIT_POWER_DEVICE]
    		$PreprocessorDefinitions    		"$BASE;VKZ_EMBEDDED_SPRINT_DEVICE_FIELD" [$VKZ_EMBEDDED_SPRINT_DEVICE_FIELD]
        $PreprocessorDefinitions        "$BASE;VKZ_EMBEDDED_BREATHER_DEVICE_FIELD" [$VKZ_EMBEDDED_BREATHER_DEVICE_FIELD]
	}
}
